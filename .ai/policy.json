{
  "version": 1,
  "limits": {
    "maxRepairCycles": 3,
    "maxAgentSteps": 20,
    "maxCommandMs": 600000,
    "maxOutputChars": 30000,
    "claudeMaxBudgetUsdPerRun": 2
  },
  "autoApprove": {
    "workspaceWrites": true,
    "localCommit": false,
    "commands": [
      { "executable": "npm", "argsPrefix": ["test"] },
      { "executable": "npm", "argsPrefix": ["run", "lint"] },
      { "executable": "npm", "argsPrefix": ["run", "build"] },
      { "executable": "npm", "argsPrefix": ["run", "check"] },
      { "executable": "git", "argsPrefix": ["status"] },
      { "executable": "git", "argsPrefix": ["diff"] },
      { "executable": "git", "argsPrefix": ["log"] }
    ]
  },
  "alwaysRequireHuman": [
    "external_write",
    "production_change",
    "purchase",
    "secret_access",
    "destructive",
    "filesystem_outside_workspace",
    "network_expansion"
  ]
}
