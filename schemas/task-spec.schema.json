{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "goal", "acceptanceCriteria", "assumptions", "nonGoals", "allowedPaths", "validationCommands", "riskLevel"],
  "properties": {
    "id": { "type": "string", "pattern": "^TASK-[A-Z0-9-]+$" },
    "goal": { "type": "string", "minLength": 1 },
    "acceptanceCriteria": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "assumptions": { "type": "array", "items": { "type": "string" } },
    "nonGoals": { "type": "array", "items": { "type": "string" } },
    "allowedPaths": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "validationCommands": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["executable", "args", "label"],
        "properties": {
          "executable": { "type": "string", "minLength": 1 },
          "args": { "type": "array", "items": { "type": "string" } },
          "label": { "type": "string", "minLength": 1 },
          "timeoutMs": { "type": "integer", "minimum": 1000 }
        }
      }
    },
    "riskLevel": { "enum": ["local-safe", "approval-required"] }
  }
}
